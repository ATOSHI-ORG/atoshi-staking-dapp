# ─────────────────────────────────────────────────────────────────────────────
# 数据来源
# ─────────────────────────────────────────────────────────────────────────────
# mock  = 内置模拟数据，不需要节点。给产品/设计看页面用。（默认）
# chain = 连真链，需要下面的 VITE_REST_URL。
VITE_API_MODE="mock"

# Cosmos REST（LCD）根地址，VITE_API_MODE=chain 时必填。
#
# ⚠️ 这里要的是节点 app.toml 里 [api] 暴露的端口（默认 1317），
#    不是 EVM JSON-RPC（8545），也不是 CometBFT RPC（26657）。
#    质押/委托/奖励/解质押的数据都在 Cosmos 模块里，
#    EVM JSON-RPC 一个都查不到 —— 没有 eth_* 方法能读 cosmos/staking。
#
# 自检：这个地址加上 /cosmos/base/tendermint/v1beta1/node_info 应该返回 JSON。
VITE_REST_URL="https://api-testnet.atoshi.org"

# chain 模式下首屏用哪个地址查只读数据。
# 接入钱包后由 window.atoshiWallet.getAddress() 提供，这个只是没钱包时的兜底。
VITE_DEMO_ADDRESS=""

# ─────────────────────────────────────────────────────────────────────────────
# 链参数（一般不用改）
# ─────────────────────────────────────────────────────────────────────────────
# 质押币最小单位。1 ATOS = 10^18 liao
VITE_BOND_DENOM="liao"
# 奖励币最小单位。1 ATOX = 10^18 aatox
VITE_ATOX_DENOM="aatox"
# 出块间隔（秒），用于把「每块 ATOX 产出」换算成年化
VITE_BLOCK_SECONDS="5"
