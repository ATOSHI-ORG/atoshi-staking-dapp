# ─────────────────────────────────────────────────────────────────────────────
# 数据来源
# ─────────────────────────────────────────────────────────────────────────────
# mock  = 内置模拟数据，不需要节点。给产品/设计看页面用。（默认）
# chain = 连真链。
VITE_API_MODE="chain"

# ─────────────────────────────────────────────────────────────────────────────
# 读：Cosmos REST（LCD）
# ─────────────────────────────────────────────────────────────────────────────
# 验证人、委托、奖励、解质押这些数据都在 Cosmos 模块里，只有 REST 能读到。
#
# 要的是节点 app.toml 里 [api] 暴露的端口（默认 1317），
# 不是 EVM JSON-RPC（8545），也不是 CometBFT RPC（26657）。
#
# 自检（返回 JSON 就对了，返回 404 说明填成了别的端口）：
#   curl <这个地址>/cosmos/base/tendermint/v1beta1/node_info
VITE_REST_URL="https://rpc-testnet.atoshi.org/rest-api"

# 没连钱包时用哪个地址查只读数据，让页面有东西可渲染。
# 连上钱包后会被钱包地址覆盖。留空则不查账户相关数据。
VITE_DEMO_ADDRESS=""

# ─────────────────────────────────────────────────────────────────────────────
# 写：EVM JSON-RPC + 预编译
# ─────────────────────────────────────────────────────────────────────────────
# 质押/解质押/转委托/领取奖励是通过 EVM 预编译发的普通以太坊交易，
# 钱包签名。这里配的是等交易回执用的 RPC。
VITE_EVM_RPC_URL="https://rpc-testnet.atoshi.org"

# 链 id。钱包连在别的链上时页面会提示切链。测试网 88288。
VITE_CHAIN_ID="88288"

# 区块浏览器，交易成功后的跳转链接用
VITE_EXPLORER_URL="https://explorer-testnet.atoshi.org"

# ─────────────────────────────────────────────────────────────────────────────
# 链参数（一般不用改）
# ─────────────────────────────────────────────────────────────────────────────
# 质押币最小单位。1 ATOS = 10^18 liao
VITE_BOND_DENOM="liao"
# 奖励币最小单位。1 ATOX = 10^18 aatox
VITE_ATOX_DENOM="aatox"
# 出块间隔（秒），用于把「每块 ATOX 产出」换算成年产出
VITE_BLOCK_SECONDS="5"
